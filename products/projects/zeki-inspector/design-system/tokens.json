{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "Zeki Inspector",
    "version": "0.1.0",
    "status": "brand-baseline",
    "source": "Zeki Inspector brand guide board",
    "note": "Brand colors and typography are source-derived. Radius, spacing, shadow and dark-theme semantic values are implementation proposals and must be visually validated before being frozen."
  },
  "color": {
    "brand": {
      "cream": "#FFF8EB",
      "ink": "#2E2A24",
      "mint": "#7DBA8A",
      "blue": "#A7C2F3",
      "pink": "#F8C9CF",
      "yellow": "#FFE39F"
    },
    "light": {
      "background": "#FFF8EB",
      "surface": "#FFFFFF",
      "surfaceMuted": "#FFFDF8",
      "foreground": "#2E2A24",
      "muted": "#6F675F",
      "border": "#D9D2C7",
      "primary": "#7DBA8A",
      "primaryForeground": "#2E2A24",
      "secondary": "#A7C2F3",
      "accent": "#F8C9CF",
      "highlight": "#FFE39F",
      "selected": "#DDF0DF",
      "info": "#DCE8FC",
      "success": "#DDF0DF",
      "warning": "#FFF0C8",
      "danger": "#F8D9DC"
    },
    "dark": {
      "status": "draft",
      "background": "#20201D",
      "surface": "#2B2A26",
      "surfaceMuted": "#34322D",
      "foreground": "#FFF8EB",
      "muted": "#C8C0B6",
      "border": "#4A463E",
      "primary": "#8FC89A",
      "primaryForeground": "#20201D",
      "secondary": "#A7C2F3",
      "accent": "#F8C9CF",
      "highlight": "#FFE39F",
      "selected": "#304C35",
      "info": "#34445F",
      "success": "#304C35",
      "warning": "#5B4B2B",
      "danger": "#59383C"
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "Nunito, Quicksand, Baloo 2, system-ui, sans-serif",
      "code": "JetBrains Mono, Fira Code, Source Code Pro, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "size": {
      "xs": "11px",
      "sm": "12px",
      "md": "13px",
      "base": "14px",
      "lg": "16px",
      "xl": "20px",
      "display": "28px"
    },
    "lineHeight": {
      "xs": "16px",
      "sm": "16px",
      "md": "18px",
      "base": "20px",
      "lg": "22px",
      "xl": "26px",
      "display": "32px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "shape": {
    "status": "implementation-proposal",
    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "pill": "999px"
    },
    "borderWidth": {
      "default": "1px",
      "strong": "1.5px"
    }
  },
  "spacing": {
    "status": "implementation-proposal",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px"
  },
  "shadow": {
    "status": "implementation-proposal",
    "toolbar": "0 6px 20px rgba(46,42,36,0.18)",
    "card": "0 4px 16px rgba(46,42,36,0.14)",
    "popover": "0 8px 24px rgba(46,42,36,0.18)"
  },
  "motion": {
    "status": "implementation-proposal",
    "fast": "120ms",
    "normal": "160ms",
    "slow": "220ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "component": {
    "toolbar": {
      "status": "implementation-proposal",
      "height": "52px",
      "radius": "16px",
      "padding": "6px",
      "gap": "4px"
    },
    "button": {
      "status": "implementation-proposal",
      "height": "34px",
      "radius": "12px",
      "paddingX": "10px",
      "iconSize": "16px"
    },
    "pill": {
      "height": "24px",
      "radius": "999px",
      "paddingX": "10px"
    },
    "card": {
      "status": "implementation-proposal",
      "radius": "16px",
      "padding": "16px"
    },
    "popover": {
      "status": "implementation-proposal",
      "radius": "16px",
      "padding": "12px"
    },
    "statusChip": {
      "height": "28px",
      "radius": "999px",
      "paddingX": "10px"
    }
  }
}