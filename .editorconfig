# File: .editorconfig
# Purpose: 统一仓库文本文件的编码、换行和缩进约定。
# Layer: Repository / Configuration

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
